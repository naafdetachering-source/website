# Kopieer dit bestand naar ".env" en vul je eigen gegevens in.
# ".env" wordt nooit meegestuurd/gedeeld — dat is waar je echte wachtwoorden horen te staan.

# Willekeurige, geheime string. Gebruik bijvoorbeeld: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=verander-dit-in-iets-geheims

# E-mailadres waar nieuwe aanvragen/aanmeldingen naartoe worden gestuurd
MAIL_TO=hallo@naaf.nl

# SMTP-instellingen om e-mail te kunnen versturen.
# Voorbeeld voor een Gmail-account met een "app-wachtwoord" (niet je gewone wachtwoord):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=jouwadres@gmail.com
#   SMTP_PASSWORD=jouw-app-wachtwoord
#   MAIL_FROM=jouwadres@gmail.com
#
# Vraag anders bij je (toekomstige) hostingpartij of domeinregistrar naar de
# SMTP-gegevens die bij je zakelijke e-mailadres (bijv. hallo@naaf.nl) horen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Pad naar de SQLite-database (optioneel, standaard: naaf.db in de projectmap)
DATABASE_PATH=

# Wachtwoord voor het beheerpaneel (/admin/opdrachten), waar jij zelf
# opdrachten plaatst en sollicitaties bekijkt. Kies iets unieks, niet
# hetzelfde wachtwoord dat je ergens anders gebruikt.
ADMIN_PASSWORD=kies-hier-een-eigen-wachtwoord

# Voor de "Automatisch invullen met AI"-knop bij het plaatsen van een opdracht.
# Groq is gratis, geen creditcard nodig: maak een account op console.groq.com,
# maak daar een API key aan en zet 'm hieronder. Dit vult zelf geen tarief in
# — dat doe je altijd zelf.
GROQ_API_KEY=

# Zet op 0 zodra je live gaat (voorkomt dat foutmeldingen met code aan bezoekers getoond worden)
FLASK_DEBUG=1
PORT=5000
